#!/bin/sh
#===============================================================================
# 991_ap_custom_settings - AP 专用定制配置
# 
# 功能：系统启动时的自定义配置（AP 模式优化）
# IP 地址：192.168.2.253
# 网关：192.168.2.254
# DNS：223.5.5.5 / 119.29.29.29
# VLAN：233（所有 LAN 口 untagged）
#===============================================================================

#-------------------------------------------------------------------------------
# 配置参数
#-------------------------------------------------------------------------------
CONNTRACK_MAX=65535
DROPBEAR_CONFIG="dropbear.main"

# 网络配置
LAN_IP="192.168.2.253"
LAN_NETMASK="255.255.255.0"
LAN_GATEWAY="192.168.2.254"
LAN_DNS="223.5.5.5 119.29.29.29"

# VLAN 配置
VLAN_ID="233"
VLAN_INTERFACE="br-lan.${VLAN_ID}"

#-------------------------------------------------------------------------------
# 辅助函数：输出日志
#-------------------------------------------------------------------------------
log_info() {
    echo "[INFO] $*"
}

log_error() {
    echo "[ERROR] $*" >&2
}

#-------------------------------------------------------------------------------
# 配置 nf_conntrack_max（最大连接跟踪数）
#-------------------------------------------------------------------------------
configure_conntrack() {
    local current_value
    local sysctl_conf="/etc/sysctl.conf"
    local conf_key="net.netfilter.nf_conntrack_max"
    
    # 检查 sysctl 是否支持该参数
    if ! sysctl -n "$conf_key" >/dev/null 2>&1; then
        log_error "系统不支持 $conf_key 参数，跳过配置"
        return 1
    fi
    
    # 获取当前值
    current_value=$(sysctl -n "$conf_key" 2>/dev/null)
    
    # 验证获取的值是否有效
    if [ -z "$current_value" ] || ! [ "$current_value" -gt 0 ] 2>/dev/null; then
        log_error "无法获取有效的 $conf_key 当前值"
        return 1
    fi
    
    # 如果当前值已大于等于目标值，无需修改
    if [ "$current_value" -ge "$CONNTRACK_MAX" ]; then
        log_info "nf_conntrack_max 当前值 ($current_value) 已满足要求"
        return 0
    fi
    
    log_info "当前 nf_conntrack_max=$current_value，目标值=$CONNTRACK_MAX，正在更新..."
    
    # 清理旧的配置
    if [ -f "$sysctl_conf" ]; then
        sed -i "/${conf_key}/d" "$sysctl_conf"
    fi
    
    # 添加新配置
    echo "${conf_key} = ${CONNTRACK_MAX}" >> "$sysctl_conf"
    
    # 应用配置
    if sysctl -p >/dev/null 2>&1; then
        log_info "nf_conntrack_max 已更新为 $CONNTRACK_MAX"
        return 0
    else
        log_error "应用 sysctl 配置失败"
        return 1
    fi
}

#-------------------------------------------------------------------------------
# 解除 dropbear SSH 访问限制
#-------------------------------------------------------------------------------
configure_dropbear() {
    local config_section="$DROPBEAR_CONFIG"
    
    # 检查 dropbear 配置是否存在
    if ! uci show "$config_section" >/dev/null 2>&1; then
        log_error "dropbear 配置不存在，跳过"
        return 1
    fi
    
    # 检查是否存在 DirectInterface 限制
    if ! uci show "$config_section" | grep -q "DirectInterface"; then
        log_info "dropbear 未设置 DirectInterface 限制"
        return 0
    fi
    
    log_info "正在解除 dropbear DirectInterface 访问限制..."
    
    # 删除限制配置
    if uci delete "${config_section}.DirectInterface" 2>/dev/null; then
        # 提交更改
        if uci commit "$config_section" 2>/dev/null; then
            # 重启 dropbear 服务
            if /etc/init.d/dropbear restart >/dev/null 2>&1; then
                log_info "dropbear 访问限制已解除，服务已重启"
                return 0
            else
                log_error "重启 dropbear 服务失败"
                return 1
            fi
        else
            log_error "提交 dropbear 配置失败"
            return 1
        fi
    else
        log_error "删除 DirectInterface 配置失败"
        return 1
    fi
}

#-------------------------------------------------------------------------------
# 网络优化配置（AP 模式专用）
#-------------------------------------------------------------------------------
configure_network_optimization() {
    local sysctl_conf="/etc/sysctl.conf"
    
    log_info "正在应用 AP 模式网络优化配置..."
    
    # 清理旧的网络优化配置
    if [ -f "$sysctl_conf" ]; then
        sed -i '/^net\.netfilter\.nf_conntrack_tcp_timeout/d' "$sysctl_conf"
        sed -i '/^net\.ipv4\.tcp_/d' "$sysctl_conf"
        sed -i '/^net\.core\./d' "$sysctl_conf"
    fi
    
    # AP 模式专用优化
    cat >> "$sysctl_conf" << 'EOF'

#========== AP 模式网络优化 ==========#
# 连接跟踪超时优化
net.netfilter.nf_conntrack_tcp_timeout_established = 86400
net.netfilter.nf_conntrack_tcp_timeout_syn_recv = 30
net.netfilter.nf_conntrack_tcp_timeout_syn_sent = 30
net.netfilter.nf_conntrack_tcp_timeout_fin_wait = 30
net.netfilter.nf_conntrack_tcp_timeout_close_wait = 10
net.netfilter.nf_conntrack_tcp_timeout_time_wait = 30

# TCP 性能优化
net.ipv4.tcp_congestion_control = bbr
net.ipv4.tcp_fastopen = 3
net.ipv4.tcp_fin_timeout = 15
net.ipv4.tcp_keepalive_time = 300
net.ipv4.tcp_keepalive_probes = 3
net.ipv4.tcp_keepalive_intvl = 10
net.ipv4.tcp_tw_reuse = 1
net.ipv4.tcp_max_tw_buckets = 4096

# TCP 缓冲区
net.ipv4.tcp_rmem = 4096 87380 16777216
net.ipv4.tcp_wmem = 4096 65536 16777216
net.core.rmem_default = 131072
net.core.wmem_default = 131072
net.core.rmem_max = 8388608
net.core.wmem_max = 8388608

# 网络队列
net.core.netdev_max_backlog = 3000
net.core.somaxconn = 2048
net.ipv4.ip_local_port_range = 1024 65535
net.ipv4.tcp_max_syn_backlog = 4096
EOF
    
    # 应用配置
    if sysctl -p >/dev/null 2>&1; then
        log_info "AP 模式网络优化配置已应用"
        return 0
    else
        log_error "应用网络优化配置失败"
        return 1
    fi
}

#-------------------------------------------------------------------------------
# 禁用防火墙（AP 模式不需要）
#-------------------------------------------------------------------------------
disable_firewall() {
    log_info "正在禁用防火墙（AP 模式）..."
    
    # 停止防火墙服务
    if /etc/init.d/firewall stop 2>/dev/null; then
        log_info "防火墙服务已停止"
    else
        log_error "防火墙服务不存在或已停止"
    fi
    
    # 禁用开机自启
    if /etc/init.d/firewall disable 2>/dev/null; then
        log_info "防火墙开机自启已禁用"
    else
        log_error "禁用防火墙开机自启失败"
    fi
    
    # 清空所有防火墙规则
    if command -v iptables >/dev/null 2>&1; then
        iptables -F 2>/dev/null
        iptables -t nat -F 2>/dev/null
        iptables -t mangle -F 2>/dev/null
        log_info "iptables 规则已清空"
    fi
    
    if command -v nft >/dev/null 2>&1; then
        nft flush ruleset 2>/dev/null
        log_info "nftables 规则已清空"
    fi
    
    log_info "防火墙已完全禁用"
}

#-------------------------------------------------------------------------------
# 配置 VLAN 233
#-------------------------------------------------------------------------------
configure_vlan() {
    log_info "正在配置 VLAN $VLAN_ID..."
    
    # 1. 启用网桥 VLAN 过滤
    uci set network.br-lan="device"
    uci set network.br-lan.name="br-lan"
    uci set network.br-lan.type="bridge"
    uci set network.br-lan.vlan_filtering="1"
    
    # 2. 添加 LAN 口到网桥
    uci del_list network.br-lan.ports="lan1" 2>/dev/null
    uci del_list network.br-lan.ports="lan2" 2>/dev/null
    uci del_list network.br-lan.ports="lan3" 2>/dev/null
    uci del_list network.br-lan.ports="lan4" 2>/dev/null
    uci add_list network.br-lan.ports="lan1"
    uci add_list network.br-lan.ports="lan2"
    uci add_list network.br-lan.ports="lan3"
    uci add_list network.br-lan.ports="lan4"
    
    # 3. 删除旧的 VLAN 配置
    uci delete network.vlan1 2>/dev/null
    uci delete network.vlan100 2>/dev/null
    uci delete network.vlan233 2>/dev/null
    
    # 4. 定义 VLAN 233（所有端口 untagged）
    uci set network.vlan233="bridge-vlan"
    uci set network.vlan233.device="br-lan"
    uci set network.vlan233.vlan="$VLAN_ID"
    uci add_list network.vlan233.ports="lan1:u*"
    uci add_list network.vlan233.ports="lan2:u*"
    uci add_list network.vlan233.ports="lan3:u*"
    uci add_list network.vlan233.ports="lan4:u*"
    
    # 5. 将 LAN 接口绑定到 VLAN 233 子接口
    uci set network.lan.device="$VLAN_INTERFACE"
    
    # 6. 删除可能残留的其他 VLAN 子接口配置
    uci delete network.vlan100_iface 2>/dev/null
    
    log_info "VLAN $VLAN_ID 配置完成"
}

#-------------------------------------------------------------------------------
# 配置 AP 模式网络（固定 IP + 网关 + DNS）
#-------------------------------------------------------------------------------
configure_ap_network() {
    log_info "正在配置 AP 模式网络..."
    log_info "LAN IP: $LAN_IP/$LAN_NETMASK"
    log_info "网关: $LAN_GATEWAY"
    log_info "DNS: $LAN_DNS"
    log_info "VLAN: $VLAN_ID (设备: $VLAN_INTERFACE)"
    
    # 1. LAN 口配置固定 IP（已绑定到 VLAN 233 子接口）
    uci set network.lan.proto='static'
    uci set network.lan.ipaddr="$LAN_IP"
    uci set network.lan.netmask="$LAN_NETMASK"
    uci set network.lan.gateway="$LAN_GATEWAY"
    uci set network.lan.dns="$LAN_DNS"
    
    # 2. 禁用 DHCP 服务
    uci set dhcp.lan.ignore='1'
    uci set dhcp.lan.dhcpv4='disabled'
    uci set dhcp.lan.dhcpv6='disabled'
    
    # 3. 删除 WAN 口（AP 不需要）
    uci delete network.wan 2>/dev/null
    uci delete network.wan6 2>/dev/null
    
    # 4. 删除不必要接口
    uci delete network.@switch[0] 2>/dev/null
    
    # 5. 提交网络配置
    uci commit network
    uci commit dhcp
    
    # 6. 配置 /etc/resolv.conf
    cat > /etc/resolv.conf << EOF
nameserver 223.5.5.5
nameserver 119.29.29.29
EOF
    
    log_info "AP 网络配置完成（VLAN $VLAN_ID）"
}

#-------------------------------------------------------------------------------
# 主函数
#-------------------------------------------------------------------------------
main() {
    log_info "开始应用 AP 定制配置..."
    
    # 1. 配置连接跟踪
    configure_conntrack
    
    # 2. 解除 dropbear 限制
    configure_dropbear
    
    # 3. 网络优化
    configure_network_optimization
    
    # 4. 禁用防火墙
    disable_firewall
    
    # 5. 配置 VLAN 233
    configure_vlan
    
    # 6. 配置 AP 网络
    configure_ap_network
    
    # 7. 重启网络服务使配置生效
    /etc/init.d/network restart
    
    log_info "AP 定制配置应用完成"
    log_info "管理地址: http://$LAN_IP"
    log_info "网关: $LAN_GATEWAY"
    log_info "DNS: $LAN_DNS"
    log_info "VLAN: $VLAN_ID"
}

# 执行主函数
main
